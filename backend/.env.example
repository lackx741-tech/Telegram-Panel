# Backend configuration for Telegram-Panel

# HTTP port
PORT=4000

# JWT signing secret — CHANGE THIS in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite location (defaults to backend/data/panel.db)
# DB_PATH=/absolute/path/to/panel.db
# DATA_DIR=/absolute/path/to/data

# Telegram API credentials.
# Option A — single credential pair:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Option B — credential pool for round-robin rotation (JSON array):
# TELEGRAM_API_POOL=[{"apiId":123456,"apiHash":"abc..."},{"apiId":234567,"apiHash":"def..."}]
